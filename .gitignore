# Python
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
.env

# Node / frontend
node_modules/
frontend/dist/
frontend/.vite/
frontend/tsconfig.tsbuildinfo
npm-debug.log*

# Local Postgres data (dev)
pgdata/
*.log

# Editor / OS
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json
.idea/
.DS_Store
.abacus.donotdelete

# Auto-generated documentation (PDF/DOCX from markdown)
*.pdf
*.docx

# Codebase index store (generated - rebuild with ./cbindex build)
.codebase_index/
tools/codebase_index/.venv/

# Local backups (should live outside the repo, but guard anyway)
vf-cmdb-backups/
*.tar.gz
*.dump
*.sql
*.sql.gz
.env.restored

# FEAT-6: runtime stencil cache (keep the dir, ignore downloaded SVGs)
backend/static/stencils/*.svg
# Phase 4 Sub-phase E: stencil library preview cache (keep the dir, ignore
# the per-fetch token subdirectories it accumulates at runtime)
backend/static/stencil_previews/*/
