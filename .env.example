# ---------------------------------------------------------------------------
# Virtualfactor IT CMDB — environment configuration
# Copy this file to `.env` and adjust as needed:  cp .env.example .env
# Consumed by podman-compose.yml and by the Quadlet units in deploy/quadlet/
# ---------------------------------------------------------------------------

# --- PostgreSQL ---
POSTGRES_USER=vfcmdb
POSTGRES_PASSWORD=change-me-please
POSTGRES_DB=vfcmdb
# Host port that maps to the Postgres container (container always uses 5432)
DB_PORT=5432

# --- Named volumes (advanced) ---
# Physical podman volume names. Leave the defaults unless a volume entry
# becomes corrupted ("more than one result for volume name ..."), in which
# case deploy/scripts/recover-podman-volumes.sh will repoint these to a fresh,
# uncorrupted volume automatically.
# PGDATA_VOLUME=vf-cmdb_pgdata
# PGADMIN_VOLUME=vf-cmdb_pgadmin

# --- Backend (FastAPI) ---
# Host port for the REST API
BACKEND_PORT=8000
# Comma-separated list of allowed CORS origins, or * for all
CORS_ORIGINS=*
API_PREFIX=/api/v1

# --- Frontend (React + Nginx) ---
# Host port for the web UI
FRONTEND_PORT=8080

# --- pgAdmin ---
PGADMIN_PORT=5050
# Native pgAdmin variable names (used by both compose and Quadlet)
PGADMIN_DEFAULT_EMAIL=admin@virtualfactor.local
PGADMIN_DEFAULT_PASSWORD=admin

# --- Ansible Semaphore (Phase 5) ---
# The Automation_Client engine device automation runs against. Host port for
# its web UI / API.
SEMAPHORE_PORT=3000
SEMAPHORE_ADMIN=admin
SEMAPHORE_ADMIN_NAME=Admin
SEMAPHORE_ADMIN_EMAIL=admin@virtualfactor.local
# REQUIRED — no default on purpose, podman-compose refuses to start Semaphore
# without these. Generate both once before first `podman compose up`:
#   openssl rand -base64 24 | tr -d '/+=' | cut -c1-24   # -> SEMAPHORE_ADMIN_PASSWORD
#   openssl rand -base64 32                              # -> SEMAPHORE_ACCESS_KEY_ENCRYPTION (must be exactly 32 bytes, base64-encoded)
SEMAPHORE_ADMIN_PASSWORD=
SEMAPHORE_ACCESS_KEY_ENCRYPTION=
# SEMAPHORE_VOLUME=vf-cmdb_semaphore

# --- Bitwarden Secrets Manager (Phase 5, optional) ---
# vf-cmdb-managed credentials (Task 34+) are stored in your existing
# Bitwarden Organization's Secrets Manager instead of this app's own
# database. Leave all three blank to run without credential features.
# BW_ORGANIZATION_ID=
# BW_ACCESS_TOKEN=
# BW_PROJECT_ID=
# Only needed for a self-hosted Bitwarden server; defaults to bitwarden.com.
# BW_API_URL=https://api.bitwarden.com
# BW_IDENTITY_URL=https://identity.bitwarden.com
